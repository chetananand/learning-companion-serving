# Pinned versions (NFR-05). Checked on 2026-09-27 against the release pages and the llm-d guides.
# Pin images by digest at install time (make pin-digests writes cluster/state/digests.env).

# Cluster
K3S_VERSION=v1.36.4+k3s1
HAMI_CHART_VERSION=2.10.0
NVIDIA_DEVICE_PLUGIN_VERSION=v0.18.2
KEDA_CHART_VERSION=2.21.0
KUBE_PROMETHEUS_STACK_VERSION=91.8.0
GRAFANA_IMAGE_RENDERER_VERSION=v5.12.4   # grafana.imageRenderer (checked 2026-09-28)
DCGM_EXPORTER_CHART_VERSION=4.8.4

# Gateway box
GATEWAY_API_VERSION=v1.5.1
GAIE_VERSION=v1.5.0
ENVOY_GATEWAY_VERSION=v1.8.4
ENVOY_AI_GATEWAY_VERSION=v1.1.0
ENVOY_AI_GATEWAY_FALLBACK_VERSION=v0.7.0
LLMD_ROUTER_VERSION=v0.11.0
LLMD_ROUTER_FALLBACK_VERSION=v0.10.0
LLMD_ROUTING_SIDECAR_IMAGE=ghcr.io/llm-d/llm-d-router-disagg-sidecar:v0.11.0

# Engine and KV
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_FALLBACK_IMAGE=vllm/vllm-openai:v0.26.0
GUARD_SAFETY_VLLM_FALLBACK_IMAGE=vllm/vllm-openai:v0.20.2
LMCACHE_VERSION=0.5.5
MAIN_MODEL=RedHatAI/gemma-4-31B-it-FP8-dynamic
CHALLENGER_MODEL=meta-models/Muse-Glimmer-30B
DEV_MODEL=google/gemma-4-E4B-it

# Guard
NEMO_GUARDRAILS_VERSION=0.24.1
GUARD_SAFETY_MODEL=nvidia/Nemotron-3.5-Content-Safety
GUARD_INJECTION_MODEL=meta-llama/Llama-Prompt-Guard-2-86M  # A8 done 2026-09-27; fallback protectai/deberta-v3-base-prompt-injection-v2

# Data plane
QDRANT_VERSION=v1.19.1
REDIS_IMAGE=redis:8.2-alpine
SIE_VERSION=v0.8.3
SIE_EMBED_IMAGE=ghcr.io/superlinked/sie-server:v0.8.3-cuda12-default
SIE_OCR_IMAGE=ghcr.io/superlinked/sie-server:v0.8.3-cuda12-sglang-vision-extract
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright/python:v1.63.0-noble
NGINX_IMAGE=nginx:1.29-alpine
