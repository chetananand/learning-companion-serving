  {
   "type": "timeseries",
   "title": "Prefix-cache hit ratio for each pod (it drops after a cache clear, E7)",
   "description": "The ghost count comes from the Envoy access log: tools/ghosts.py.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (pod) (rate(vllm:prefix_cache_hits_total[30s])) / sum by (pod) (rate(vllm:prefix_cache_queries_total[30s]))",
     "legendFormat": "{{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
