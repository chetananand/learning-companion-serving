    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (warm, le) (rate(orch_first_ttft_seconds_bucket[10m])))",
     "legendFormat": "warm={{warm}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
