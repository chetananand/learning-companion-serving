    "epp_config": "# GENERATED by control/router/render.py from control/router/policy.yaml. Do not edit.\napiVersion: llm-d.ai/v1alpha1\nkind: EndpointPickerConfig\nfeatureGates:\n- flowControl\nplugins:\n- type: endpoint-notification-source\n- type: token-producer\n  parameters:\n    modelName: RedHatAI/gemma-4-31B-it-FP8-dynamic\n    vllm:\n      url: http://localhost:8000\n- type: precise-prefix-cache-producer\n  parameters:\n    tokenProcessorConfig:\n      blockSizeTokens: 64\n    indexerConfig:\n      kvBlockIndexConfig:\n        enableMetrics: true\n    kvEventsConfig:\n      topicFilter: kv@\n      concurrency: 8\n      discoverPods: true\n      podDiscoveryConfig:\n        socketPort: 5556\n        replaySocketPort: 5559\n- type: prefix-cache-scorer\n  parameters:\n    prefixMatchInfoProducerName: precise-prefix-cache-producer\n- type: queue-scorer\n- type: kv-cache-utilization-scorer\n- type: token-load-scorer\n- type: session-affinity-scorer\n  parameters:\n    strategy: session_id\n- type: label-producer\n  parameters:\n    labels:\n    - label: companion.io/ramp\n      attributeKey: ramp\n- type: endpoint-attribute-weight-scorer\n  name: ramp-scorer\n  parameters:\n    attributeKey: ramp\n    producer: label-producer\n    weights:\n      r10: 0.1\n      r25: 0.25\n      r50: 0.5\n      r100: 1.0\n- type: label-selector-filter\n  name: warm-filter\n  parameters:\n    matchLabels:\n      companion.io/warm: 'true'\n- type: max-score-picker\n  name: picker\n- type: single-profile-handler\n- type: round-robin-fairness-policy\n- type: fcfs-ordering-policy\n- type: priority-holdback-policy\n  parameters:\n    minCeiling: 0.7\n    maxCeiling: 1.0\n- type: utilization-detector\n  parameters:\n    queueDepthThreshold: 5\n    kvCacheUtilThreshold: 0.9\n    metricsStalenessThreshold: 2s\n    stalenessPolicy: saturated\ndataLayer:\n  sources:\n  - pluginRef: endpoint-notification-source\n    extractors:\n    - pluginRef: precise-prefix-cache-producer\n    - pluginRef: label-producer\nschedulingProfiles:\n- name: default\n  plugins:\n  - pluginRef: warm-filter\n  - pluginRef: prefix-cache-scorer\n    weight: 3.0\n  - pluginRef: session-affinity-scorer\n    weight: 2.0\n  - pluginRef: queue-scorer\n    weight: 2.0\n  - pluginRef: kv-cache-utilization-scorer\n    weight: 2.0\n  - pluginRef: ramp-scorer\n    weight: 2.0\n  - pluginRef: picker\nflowControl:\n  defaultRequestTTL: 60s\n  priorityBands:\n  - priority: 10\n    defaultRequestTTL: 10s\n    fairnessPolicyRef: round-robin-fairness-policy\n    orderingPolicyRef: fcfs-ordering-policy\n  - priority: 0\n    defaultRequestTTL: 120s\n    fairnessPolicyRef: round-robin-fairness-policy\n    orderingPolicyRef: fcfs-ordering-policy\n  usageLimitPolicyPluginRef: priority-holdback-policy\n  saturationDetector:\n    pluginRef: utilization-detector\n"
