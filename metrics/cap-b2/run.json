  "router_policy": "# Our router policy (system design sections 6.2 to 6.5). We own these numbers.\n# `python -m control.router.render` turns this file into:\n#   - the llm-d EndpointPickerConfig (flow control, scheduling profiles, P/D decider, warm gate, ramp)\n#   - the InferenceObjectives (priority bands)\n#   - the Agent Router tenant windows (AIGatewayRoute token costs and a BackendTrafficPolicy)\n# Values are start values. The experiments tune them (E3, E5, E10, E11).\n\nmodel_name: RedHatAI/gemma-4-31B-it-FP8-dynamic\nserved_model_name: companion\nnamespace: companion\npool: companion-router   # the router chart names the InferencePool after the Helm release (install.sh, G0)\ngateway: companion-gateway\n\n# prefix_then_load | least_loaded | random (system design section 6.3; E3 switches it)\npolicy: prefix_then_load\n# precise: KV events from vLLM (default). approx: request history only (E7 arm A).\nprefix_index: precise\n# decider: option C (default). always: option B. off: option A, one profile with the role prefill-decode.\npd_mode: decider\npd_non_cached_tokens: 2048\n\n# Must equal the vLLM --block-size on every pod (issue 52234) and the KV-event block size.\nblock_size_tokens: 64\nkv_events:\n  socket_port: 5556\n  replay_socket_port: 5559\n  topic_filter: \"kv@\"\nrender_service_url: http://localhost:8000   # the router chart tokenizer sidecar (tokenizer.enabled); VERIFY at G0\nrouter_chart:\n  epp_image_tag: v0.11.0                    # fallback v0.10.0 if the G0 smoke test fails\n  failure_mode: FailClose                   # a router outage must not bypass admission and flow control\n  model_server_labels: {app.kubernetes.io/part-of: companion-vllm}\n  target_port: 8000\n\nweights:\n  decode: {prefix: 3, session: 2, queue: 2, kv_util: 2, ramp: 2}\n  prefill: {prefix: 3, token_load: 2, queue: 2, ramp: 2}\n\nwarm:\n  label: companion.io/warm\n  ramp_label: companion.io/ramp\n  ramp_weights: {r10: 0.10, r25: 0.25, r50: 0.50, r100: 1.00}\n\nflow_control:\n  default_request_ttl: 60s\n  bands:\n    - {objective: interactive, priority: 10, ttl: 10s}\n    - {objective: batch, priority: 0, ttl: 120s}\n  fairness: round-robin-fairness-policy\n  ordering: fcfs-ordering-policy        # E10 compares edf-ordering-policy\n  usage_limit: priority-holdback-policy\n  # llm-d v0.11 needs minCeiling (G0, 2026-09-28). Batch (the lowest band) waits above 70% saturation;\n  # interactive (the highest band) waits only at 100%.\n  usage_limit_parameters: {minCeiling: 0.7, maxCeiling: 1.0}\n  saturation:\n    queue_depth_threshold: 5\n    kv_cache_util_threshold: 0.90\n    metrics_staleness_threshold: 2s\n    staleness_policy: saturated           # class7 rule: unknown is not idle\n\ntenants:\n  owner: {tokens_per_minute: 600000, requests_per_minute: 300}\n  sweep: {tokens_per_minute: 300000, requests_per_minute: 120}\n  noisy: {tokens_per_minute: 60000, requests_per_minute: 60}\nload_tenants:\n  count: 32                               # load-1 to load-32 (app/loadgen/replay.py LOAD_TENANTS): the load\n                                          # reaches the engine limit before the tenant windows\n  tokens_per_minute: 400000\n  requests_per_minute: 240\n",
